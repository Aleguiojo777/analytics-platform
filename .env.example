# DataLens Configuration - Copy to .env and customize as needed

# ===== SERVER CONFIGURATION =====
# Port the Flask server listens on (default: 3000)
PORT=3000

# Host to bind to (default: 127.0.0.1 for localhost only)
HOST=127.0.0.1

# Enable Flask debug mode (default: false)
FLASK_DEBUG=false

# ===== DATABASE CONFIGURATION =====
# ODBC driver name (default: ODBC Driver 18 for SQL Server)
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Database connection timeout in seconds (default: 10)
DB_CONNECTION_TIMEOUT=10

# ===== API CONFIGURATION =====
# Comma-separated CORS origins (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum request size in bytes (default: 10MB)
MAX_REQUEST_SIZE=10485760

# Request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30

# ===== ANALYTICS & DATA LIMITS =====
# Maximum rows to fetch for sample data (default: 100)
MAX_SAMPLE_ROWS=100

# Maximum numeric columns to analyze (default: 6)
MAX_NUMERIC_COLUMNS=6

# Maximum text columns to analyze (default: 8)
MAX_TEXT_COLUMNS=8

# Maximum table results to fetch (default: 1000)
MAX_TABLE_RESULTS=1000

# ===== PAGINATION =====
# Default page size for paginated results (default: 50)
DEFAULT_PAGE_SIZE=50

# Maximum allowed page size (default: 500)
MAX_PAGE_SIZE=500

# ===== ANOMALY DETECTION =====
# Z-score threshold for anomaly detection (default: 2.5)
ANOMALY_Z_SCORE_THRESHOLD=2.5

# Minimum values required for anomaly detection (default: 4)
MIN_VALUES_FOR_ANOMALY_DETECTION=4

# ===== VALIDATION LIMITS =====
# Maximum field length for input validation (default: 256)
MAX_FIELD_LENGTH=256

# Maximum password length for input validation (default: 512)
MAX_PASSWORD_LENGTH=512

# Maximum table name length for input validation (default: 256)
MAX_TABLE_NAME_LENGTH=256

# ===== FEATURE FLAGS =====
# Enable anomaly detection in analytics (default: true)
ENABLE_ANOMALY_DETECTION=true

# Enable trend analysis in analytics (default: true)
ENABLE_TREND_ANALYSIS=true

# Enable data cleansing mode (default: true)
ENABLE_CLEANED_MODE=true

# Enable data export functionality (default: true)
ENABLE_DATA_EXPORT=true

# Enable optional local LLM enrichment through Ollama (default: false)
ENABLE_LOCAL_LLM=false

# Ollama chat endpoint and model. Works offline after the model is downloaded.
LOCAL_LLM_URL=http://127.0.0.1:11434/api/chat
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_TIMEOUT=180

# ===== LOGGING =====
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Logging format (default: %(asctime)s - %(name)s - %(levelname)s - %(message)s)
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
