{
  "name": "analytics-platform",
  "version": "1.0.0",
  "description": "Data Analytics Platform with SQL Server support",
  "main": "electron.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "desktop": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mssql": "^10.0.1",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "simple-statistics": "^7.8.3",
    "regression": "^2.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "electron": "^26.6.0",
    "electron-builder": "^24.7.0"
  },
  "build": {
    "appId": "com.datalens.analytics",
    "productName": "DataLens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.md"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false
  }
}
