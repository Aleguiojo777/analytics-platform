# Server
PORT=3000

# JWT Secret (change this to a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Default SQL Server Connection (optional - users can connect dynamically)
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_password
DB_NAME=master
DB_ENCRYPT=false
DB_TRUST_CERT=true
